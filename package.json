{
  "name": "wow-pvp-analyzer",
  "version": "1.0.0",
  "description": "WoW PvP analysis tool - player lookup, ratings, talent builds, meta analysis",
  "main": "dist/main.js",
  "author": "JugoBetrugoTV",
  "repository": {
    "type": "git",
    "url": "https://github.com/JugoBetrugoTV/Addon.git"
  },
  "scripts": {
    "build": "webpack --config webpack.config.js",
    "start": "electron dist/main.js",
    "dev": "webpack --config webpack.config.js --watch",
    "package": "npm run build && electron-packager . \"WoW PvP Analyzer\" --platform=win32 --arch=x64 --out=release --overwrite --ignore=\"(src|node_modules/(@types|typescript|ts-loader|webpack|html-webpack-plugin))\" --asar",
    "dist": "npm run build && electron-builder --win",
    "dist:portable": "npm run build && electron-builder --win portable",
    "release": "npm run build && electron-builder --win --publish always"
  },
  "keywords": ["wow", "pvp", "arena", "warcraft", "analyzer", "electron"],
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.2",
    "electron-updater": "^6.7.3"
  },
  "devDependencies": {
    "@electron/packager": "^18.3.0",
    "@types/node": "^20.10.0",
    "electron": "^28.0.0",
    "electron-builder": "^26.4.0",
    "html-webpack-plugin": "^5.5.4",
    "ts-loader": "^9.5.1",
    "typescript": "^5.3.2",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  },
  "build": {
    "appId": "com.wowpvp.analyzer",
    "productName": "WoW PvP Analyzer",
    "copyright": "Copyright 2024",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "node_modules/**/*",
      "!node_modules/@types/**",
      "!node_modules/typescript/**",
      "!node_modules/ts-loader/**",
      "!node_modules/webpack/**",
      "!node_modules/webpack-cli/**",
      "!node_modules/html-webpack-plugin/**",
      "!node_modules/electron-builder/**",
      "!node_modules/@electron/packager/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "WoW PvP Analyzer"
    },
    "portable": {
      "artifactName": "WoW-PvP-Analyzer-Portable-${version}.exe"
    },
    "publish": {
      "provider": "github",
      "owner": "JugoBetrugoTV",
      "repo": "Addon",
      "releaseType": "release"
    }
  }
}
