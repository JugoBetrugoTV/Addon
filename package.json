{
  "name": "codex-mortis",
  "version": "1.0.0",
  "description": "Vampire Survivors-like game built with TypeScript, PIXI.js, bitECS, and Electron",
  "main": "dist/main.js",
  "scripts": {
    "build": "webpack --config webpack.config.js",
    "start": "npm run build && electron dist/main.js",
    "dev": "webpack --config webpack.config.js --watch",
    "package": "npm run build && electron-builder --win portable",
    "package:dir": "npm run build && electron-builder --win dir"
  },
  "build": {
    "appId": "com.codexmortis.game",
    "productName": "Codex Mortis",
    "files": [
      "dist/**/*"
    ],
    "win": {
      "target": "portable",
      "icon": "assets/icon.ico"
    }
  },
  "keywords": ["game", "vampire-survivors", "typescript", "pixijs", "bitecs", "electron"],
  "license": "MIT",
  "dependencies": {
    "bitecs": "^0.3.40",
    "pixi.js": "^7.3.2"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "html-webpack-plugin": "^5.5.4",
    "ts-loader": "^9.5.1",
    "typescript": "^5.3.2",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  }
}
