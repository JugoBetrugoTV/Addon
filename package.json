{
  "name": "open-world-crime",
  "version": "0.1.0",
  "description": "Open-world crime game with procedural city, NPCs, vehicles - TypeScript + Three.js + Electron",
  "main": "dist/main.js",
  "author": "",
  "scripts": {
    "build": "webpack --config webpack.config.js",
    "start": "electron dist/main.js",
    "dev": "webpack --config webpack.config.js --watch",
    "package": "npm run build && electron-packager . \"Open World\" --platform=win32 --arch=x64 --out=release --overwrite --ignore=\"(src|node_modules/(@types|typescript|ts-loader|webpack|html-webpack-plugin))\" --asar"
  },
  "keywords": ["game", "open-world", "crime", "typescript", "threejs", "electron"],
  "license": "MIT",
  "dependencies": {
    "three": "^0.160.0"
  },
  "devDependencies": {
    "@types/three": "^0.160.0",
    "@types/node": "^20.10.0",
    "@electron/packager": "^18.3.0",
    "electron": "^28.0.0",
    "html-webpack-plugin": "^5.5.4",
    "ts-loader": "^9.5.1",
    "typescript": "^5.3.2",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  }
}
