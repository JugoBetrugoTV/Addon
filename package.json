{
  "name": "codex-mortis",
  "version": "1.0.0",
  "description": "Vampire Survivors-like game built with TypeScript, PIXI.js, bitECS, and Electron",
  "main": "dist/main.js",
  "author": "CodexMortis",
  "scripts": {
    "build": "webpack --config webpack.config.js",
    "start": "electron dist/main.js",
    "dev": "webpack --config webpack.config.js --watch",
    "package": "npm run build && electron-packager . \"Codex Mortis\" --platform=win32 --arch=x64 --out=release --overwrite --ignore=\"(src|node_modules/(@types|typescript|ts-loader|webpack|html-webpack-plugin))\" --asar"
  },
  "keywords": ["game", "vampire-survivors", "typescript", "pixijs", "bitecs", "electron"],
  "license": "MIT",
  "dependencies": {
    "bitecs": "^0.3.40",
    "pixi.js": "^7.3.2"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@electron/packager": "^18.3.0",
    "electron": "^28.0.0",
    "html-webpack-plugin": "^5.5.4",
    "ts-loader": "^9.5.1",
    "typescript": "^5.3.2",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  }
}
